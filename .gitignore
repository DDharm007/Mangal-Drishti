# Python environments & cache
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
*.tmp
*.bak

# Large datasets, raw imagery, processed image/mask tensors, and archives (NEVER commit large datasets)
datasets/raw/
datasets/samples/
datasets/processed/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.parquet
*.pt
*.pth
*.npy
*.npz

# Image & binary exclusions
*.JPG
*.jpg
*.jpeg
*.png
*.PNG

# Allow lightweight inspection outputs & metadata manifests in Git
!datasets/inspection/*.png
!datasets/inspection/*.json
!datasets/inspection/preprocessing_samples/*.png
!datasets/metadata/*.json
!datasets/metadata/*.csv

# Model checkpoints excluded; experiment metrics, reports & prediction visualizations allowed
experiments/**/*.pth
experiments/**/*.pt
experiments/evaluation/**/*.pth
experiments/evaluation/**/*.pt
!experiments/**/predictions/*.png
!experiments/**/metrics.json
!experiments/**/training_history.csv
!experiments/**/model_config.yaml
!experiments/evaluation/**/*.png
!experiments/evaluation/**/*.json
!experiments/evaluation/**/*.csv
!experiments/evaluation/**/*.yaml
!experiments/evaluation/**/*.md
!experiments/intelligence/**/*.png
!experiments/intelligence/**/*.json

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
