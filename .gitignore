# Python environments & cache
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Large datasets, raw imagery, and archives (NEVER commit large datasets)
datasets/raw/
datasets/samples/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.parquet

# Image & binary exclusions
*.JPG
*.jpg
*.jpeg
*.png
*.PNG

# Allow lightweight inspection outputs in Git
!datasets/inspection/*.png
!datasets/inspection/*.json

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
